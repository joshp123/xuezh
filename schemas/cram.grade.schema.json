{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cram.grade ok envelope",
  "type": "object",
  "required": ["ok", "schema_version", "command", "data", "artifacts", "truncated", "limits"],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "type": "string" },
    "command": { "const": "cram.grade" },
    "data": {
      "type": "object",
      "required": ["item_id", "grade", "next_due_at", "interval_minutes", "score", "difficulty", "correct_count", "incorrect_count", "reviewed_count", "scored"],
      "properties": {
        "item_id": { "type": "string" },
        "grade": { "enum": ["incorrect", "correct"] },
        "next_due_at": { "type": "string" },
        "interval_minutes": { "type": "integer" },
        "score": { "type": "integer" },
        "difficulty": { "type": "integer" },
        "correct_count": { "type": "integer" },
        "incorrect_count": { "type": "integer" },
        "reviewed_count": { "type": "integer" },
        "scored": { "type": "boolean" }
      }
    },
    "artifacts": { "type": "array" },
    "truncated": { "type": "boolean" },
    "limits": { "type": "object" }
  },
  "additionalProperties": true
}
