{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cram.overview ok envelope",
  "type": "object",
  "required": ["ok", "schema_version", "command", "data", "artifacts", "truncated", "limits"],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "type": "string" },
    "command": { "const": "cram.overview" },
    "data": {
      "type": "object",
      "required": ["generated_at", "sources", "categories"],
      "properties": {
        "generated_at": { "type": "string" },
        "sources": { "type": "array" },
        "categories": { "type": "array" }
      }
    },
    "artifacts": { "type": "array" },
    "truncated": { "type": "boolean" },
    "limits": { "type": "object" }
  },
  "additionalProperties": true
}
