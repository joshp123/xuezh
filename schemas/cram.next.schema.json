{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cram.next ok envelope",
  "type": "object",
  "required": ["ok", "schema_version", "command", "data", "artifacts", "truncated", "limits"],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "type": "string" },
    "command": { "const": "cram.next" },
    "data": {
      "type": "object",
      "required": ["cards"],
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "learning_order", "word", "pinyin", "meaning", "sentence_hanzi", "sentence_audio_paths", "status"],
            "properties": {
              "item_id": { "type": "string" },
              "learning_order": { "type": "integer" },
              "word": { "type": "string" },
              "pinyin": { "type": "string" },
              "meaning": { "type": "string" },
              "sentence_hanzi": { "type": "string" },
              "sentence_pinyin": { "type": "string" },
              "sentence_meaning": { "type": "string" },
              "sentence_audio_paths": { "type": "object" },
              "status": { "type": "string" },
              "due_at": { "type": ["string", "null"] },
              "unknown_other_words": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },
    "artifacts": { "type": "array" },
    "truncated": { "type": "boolean" },
    "limits": { "type": "object" }
  },
  "additionalProperties": true
}
